    "from google import genai\n",
    "\n",
    "client = genai.Client()  # or omit if GOOGLE_API_KEY is in env\n",
    "\n",
    "response = client.models.generate_content(\n",
    "    model=\"gemini-2.0-flash\",\n",
    "    contents=\"Say the world hello\"\n",
    ")\n",
    "\n",
    "print(response.text)"
